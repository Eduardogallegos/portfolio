# Database
DATABASE_URL=postgresql://user:password@localhost:5432/date_booking

# Security
SECRET_KEY=tu-super-secret-key-cambiar-en-produccion-min-32-chars

# Código secreto del link de invitación (genera uno con: python -c "import secrets; print(secrets.token_urlsafe(24))")
# Vacío = registro desactivado. El link es: <FRONTEND_URL>/pareja/registro/<INVITE_CODE>
INVITE_CODE=

# CORS
FRONTEND_URL=http://localhost:5173
# En producción, separa varias URLs con coma:
# FRONTEND_URL=https://egallegos.me,https://www.egallegos.me

# Environment
ENVIRONMENT=development

# Notificaciones por correo (Resend: https://resend.com)
# Sin dominio verificado solo puedes enviar al correo de tu cuenta de Resend.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=Álbum <album@egallegos.me>
